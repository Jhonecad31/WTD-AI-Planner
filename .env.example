# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mailbox that receives the agent (sales) email for every lead
LEADS_TO=sales@example.com
# Promised response time shown to the customer (hours)
NEXT_PUBLIC_RESPONSE_TIME_HOURS=24

# ─── Feature flags ──────────────────────────────────────────────────────────
# rules | claude  (claude falls back to rules automatically on error / missing key)
AI_PROVIDER=claude
# db | resend
EMAIL_PROVIDER=db
CAPTCHA_ENABLED=false

# ─── Bokun (READ-ONLY key — never grant booking permissions) ───────────────
BOKUN_BASE_URL=https://api.bokun.io
BOKUN_ACCESS_KEY=
BOKUN_SECRET_KEY=
BOKUN_BOOKING_CHANNEL_UUID=8b31caec-8877-411a-85ad-682828170619
BOKUN_CURRENCY=USD

# ─── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only needed when the key is not scoped to a workspace (Console → Settings → Workspaces → ID)
ANTHROPIC_WORKSPACE_ID=

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (only when EMAIL_PROVIDER=resend) ────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="WhatToDo Planner <planner@example.com>"

# ─── Abuse protection (production) ──────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Tripadvisor Content API (ratings + review counts; optional) ─────────────
# Map products to listings in src/content/tripadvisor.ts. Empty = ratings hidden.
TRIPADVISOR_API_KEY=

# ─── Cron (Vercel Cron calls /api/cron/catalog daily with Bearer CRON_SECRET) ──
CRON_SECRET=
# Optional: where the catalog JSON cache is written (defaults to .cache locally, /tmp on Vercel)
CATALOG_CACHE_DIR=
